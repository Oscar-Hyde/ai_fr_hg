        {"term_en": "obligation", "term_ar": "التزام", "term_he": "התחייבות"},
        {"term_en": "liability", "term_ar": "مسؤولية", "term_he": "אחריות"},
        {"term_en": "compliance", "term_ar": "امتثال", "term_he": "ציות"},
        {"term_en": "confidentiality", "term_ar": "سرية", "term_he": "סודיות"},
        {"term_en": "termination", "term_ar": "إنهاء", "term_he": "סיום"},
        {"term_en": "IP", "term_ar": "IP", "term_he": "IP", "do_not_translate": 1},
        {"term_en": "SLA", "term_ar": "SLA", "term_he": "SLA", "do_not_translate": 1}
      ]
    }
  }
