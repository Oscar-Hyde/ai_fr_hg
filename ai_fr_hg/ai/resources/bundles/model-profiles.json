    "min_ram_gb": 8,
    "required_providers": ["Local Ollama"]
  },
  "dependencies": [],
  "license": "MIT",
  "license_url": "https://opensource.org/licenses/MIT",
  "release_notes": [
    "1.0.0 - Small local chat and embedding profiles suitable for air-gapped deployments."
