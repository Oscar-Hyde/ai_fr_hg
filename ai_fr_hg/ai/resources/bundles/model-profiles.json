        "top_p": 0.9
      },
      {
        "model_label": "Local Embeddings",
        "provider_name": "Local Ollama",
        "model_name": "nomic-embed-text",
        "model_type": "Embedding",
        "enabled": 1,
        "family": "Nomic",
        "context_window": 8192,
        "embedding_dimensions": 768,
        "supports_streaming": 0,
        "supports_json_mode": 0,
        "max_tokens": 0,
        "temperature": 0,
        "top_p": 0.9
      }
    ]
  }
